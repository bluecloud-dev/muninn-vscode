{
  "name": "muninn-vscode",
  "displayName": "%extension.displayName%",
  "publisher": "blueclouddev",
  "version": "2.1.0",
  "preview": true,
  "description": "%extension.description%",
  "license": "AGPL-3.0-only",
  "engines": {
    "vscode": "^1.85.2",
    "node": ">=24"
  },
  "categories": [
    "Formatters",
    "Visualization"
  ],
  "keywords": [
    "muninn",
    "markdown",
    "markdown editor",
    "custom editor",
    "single pane",
    "reading-first",
    "wysiwyg",
    "rich markdown",
    "mermaid",
    "tables",
    "preview",
    "editor",
    "documentation",
    "readme",
    "notes"
  ],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#f5f4ef",
    "theme": "light"
  },
  "badges": [
    {
      "url": "https://github.com/bluecloud-dev/muninn-vscode/actions/workflows/ci.yml/badge.svg",
      "href": "https://github.com/bluecloud-dev/muninn-vscode/actions/workflows/ci.yml",
      "description": "CI"
    },
    {
      "url": "https://img.shields.io/github/v/release/bluecloud-dev/muninn-vscode?include_prereleases&label=release",
      "href": "https://github.com/bluecloud-dev/muninn-vscode/releases",
      "description": "Latest release"
    },
    {
      "url": "https://img.shields.io/github/license/bluecloud-dev/muninn-vscode",
      "href": "https://github.com/bluecloud-dev/muninn-vscode/blob/main/LICENSE",
      "description": "License"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bluecloud-dev/muninn-vscode.git"
  },
  "homepage": "https://github.com/bluecloud-dev/muninn-vscode#readme",
  "bugs": {
    "url": "https://github.com/bluecloud-dev/muninn-vscode/issues"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%",
      "restrictedConfigurations": [
        "muninn.integrations.mermaid.allowInUntrustedWorkspaces"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.virtualWorkspaces.description%"
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "muninn.markdownEditor",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "muninn.openRawMarkdown",
        "title": "%command.muninn.openRawMarkdown.title%",
        "category": "%command.category%",
        "icon": "$(code)",
        "enablement": "activeCustomEditorId == muninn.markdownEditor",
        "shortTitle": "%command.muninn.openRawMarkdown.shortTitle%"
      },
      {
        "command": "muninn.toggleBold",
        "title": "%command.muninn.toggleBold.title%",
        "category": "%command.category%",
        "icon": "$(bold)",
        "enablement": "activeCustomEditorId == muninn.markdownEditor",
        "shortTitle": "%command.muninn.toggleBold.shortTitle%"
      },
      {
        "command": "muninn.toggleItalic",
        "title": "%command.muninn.toggleItalic.title%",
        "category": "%command.category%",
        "icon": "$(italic)",
        "enablement": "activeCustomEditorId == muninn.markdownEditor",
        "shortTitle": "%command.muninn.toggleItalic.shortTitle%"
      },
      {
        "command": "muninn.setParagraph",
        "title": "%command.muninn.setParagraph.title%",
        "category": "%command.category%",
        "enablement": "activeCustomEditorId == muninn.markdownEditor",
        "shortTitle": "%command.muninn.setParagraph.shortTitle%"
      },
      {
        "command": "muninn.setHeading1",
        "title": "%command.muninn.setHeading1.title%",
        "category": "%command.category%",
        "enablement": "activeCustomEditorId == muninn.markdownEditor",
        "shortTitle": "%command.muninn.setHeading1.shortTitle%"
      },
      {
        "command": "muninn.setHeading2",
        "title": "%command.muninn.setHeading2.title%",
        "category": "%command.category%",
        "enablement": "activeCustomEditorId == muninn.markdownEditor",
        "shortTitle": "%command.muninn.setHeading2.shortTitle%"
      },
      {
        "command": "muninn.setHeading3",
        "title": "%command.muninn.setHeading3.title%",
        "category": "%command.category%",
        "enablement": "activeCustomEditorId == muninn.markdownEditor",
        "shortTitle": "%command.muninn.setHeading3.shortTitle%"
      },
      {
        "command": "muninn.toggleBulletList",
        "title": "%command.muninn.toggleBulletList.title%",
        "category": "%command.category%",
        "enablement": "activeCustomEditorId == muninn.markdownEditor",
        "shortTitle": "%command.muninn.toggleBulletList.shortTitle%"
      },
      {
        "command": "muninn.toggleNumberedList",
        "title": "%command.muninn.toggleNumberedList.title%",
        "category": "%command.category%",
        "enablement": "activeCustomEditorId == muninn.markdownEditor",
        "shortTitle": "%command.muninn.toggleNumberedList.shortTitle%"
      },
      {
        "command": "muninn.insertLink",
        "title": "%command.muninn.insertLink.title%",
        "category": "%command.category%",
        "enablement": "activeCustomEditorId == muninn.markdownEditor",
        "shortTitle": "%command.muninn.insertLink.shortTitle%"
      },
      {
        "command": "muninn.insertMermaidBlock",
        "title": "%command.muninn.insertMermaidBlock.title%",
        "category": "%command.category%",
        "icon": "$(symbol-structure)",
        "enablement": "activeCustomEditorId == muninn.markdownEditor",
        "shortTitle": "%command.muninn.insertMermaidBlock.shortTitle%"
      },
      {
        "command": "muninn.inspectConfiguration",
        "title": "%command.muninn.inspectConfiguration.title%",
        "category": "%command.category%",
        "icon": "$(settings-gear)",
        "shortTitle": "%command.muninn.inspectConfiguration.shortTitle%"
      },
      {
        "command": "muninn.insertTable",
        "title": "%command.muninn.insertTable.title%",
        "category": "%command.category%",
        "enablement": "activeCustomEditorId == muninn.markdownEditor",
        "shortTitle": "%command.muninn.insertTable.shortTitle%",
        "icon": "$(table)"
      },
      {
        "command": "muninn.insertCodeBlock",
        "title": "%command.muninn.insertCodeBlock.title%",
        "category": "%command.category%",
        "enablement": "activeCustomEditorId == muninn.markdownEditor",
        "shortTitle": "%command.muninn.insertCodeBlock.shortTitle%",
        "icon": "$(code)"
      },
      {
        "command": "muninn.insertImage",
        "title": "%command.muninn.insertImage.title%",
        "category": "%command.category%",
        "enablement": "activeCustomEditorId == muninn.markdownEditor",
        "shortTitle": "%command.muninn.insertImage.shortTitle%",
        "icon": "$(file-media)"
      },
      {
        "command": "muninn.addTableRow",
        "title": "%command.muninn.addTableRow.title%",
        "category": "%command.category%",
        "enablement": "activeCustomEditorId == muninn.markdownEditor",
        "shortTitle": "%command.muninn.addTableRow.shortTitle%"
      },
      {
        "command": "muninn.addTableColumn",
        "title": "%command.muninn.addTableColumn.title%",
        "category": "%command.category%",
        "enablement": "activeCustomEditorId == muninn.markdownEditor",
        "shortTitle": "%command.muninn.addTableColumn.shortTitle%"
      },
      {
        "command": "muninn.tableActions",
        "title": "%command.muninn.tableActions.title%",
        "category": "%command.category%",
        "enablement": "activeCustomEditorId == muninn.markdownEditor",
        "shortTitle": "%command.muninn.tableActions.shortTitle%",
        "icon": "$(table)"
      },
      {
        "command": "muninn.newNote",
        "title": "%command.muninn.newNote.title%",
        "category": "%command.category%",
        "icon": "$(new-file)"
      },
      {
        "command": "muninn.goToHeading",
        "title": "%command.muninn.goToHeading.title%",
        "category": "%command.category%",
        "icon": "$(list-tree)",
        "enablement": "activeCustomEditorId == muninn.markdownEditor"
      },
      {
        "command": "muninn.insertFileLink",
        "title": "%command.muninn.insertFileLink.title%",
        "category": "%command.category%",
        "icon": "$(link)",
        "enablement": "activeCustomEditorId == muninn.markdownEditor"
      },
      {
        "command": "muninn.toggleTask",
        "title": "%command.muninn.toggleTask.title%",
        "category": "%command.category%",
        "icon": "$(checklist)",
        "enablement": "activeCustomEditorId == muninn.markdownEditor"
      },
      {
        "command": "muninn.toggleStrike",
        "title": "%command.muninn.toggleStrike.title%",
        "category": "%command.category%",
        "icon": "$(strikethrough)",
        "enablement": "activeCustomEditorId == muninn.markdownEditor"
      },
      {
        "command": "muninn.undo",
        "title": "%command.muninn.undo.title%",
        "category": "%command.category%",
        "enablement": "activeCustomEditorId == muninn.markdownEditor"
      },
      {
        "command": "muninn.redo",
        "title": "%command.muninn.redo.title%",
        "category": "%command.category%",
        "enablement": "activeCustomEditorId == muninn.markdownEditor"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "muninn.goToHeading",
          "when": "activeCustomEditorId == muninn.markdownEditor",
          "group": "1_muninn@0"
        },
        {
          "command": "muninn.toggleBold",
          "when": "activeCustomEditorId == muninn.markdownEditor",
          "group": "2_muninn@0"
        },
        {
          "command": "muninn.toggleItalic",
          "when": "activeCustomEditorId == muninn.markdownEditor",
          "group": "2_muninn@1"
        },
        {
          "command": "muninn.insertMermaidBlock",
          "when": "activeCustomEditorId == muninn.markdownEditor",
          "group": "2_muninn@2"
        },
        {
          "command": "muninn.insertTable",
          "when": "activeCustomEditorId == muninn.markdownEditor",
          "group": "2_muninn@3"
        },
        {
          "command": "muninn.insertImage",
          "when": "activeCustomEditorId == muninn.markdownEditor",
          "group": "2_muninn@4"
        },
        {
          "command": "muninn.tableActions",
          "when": "activeCustomEditorId == muninn.markdownEditor",
          "group": "2_muninn@5"
        },
        {
          "command": "muninn.openRawMarkdown",
          "when": "activeCustomEditorId == muninn.markdownEditor",
          "group": "navigation@1"
        },
        {
          "command": "muninn.inspectConfiguration",
          "when": "activeCustomEditorId == muninn.markdownEditor",
          "group": "2_muninn@7"
        }
      ],
      "commandPalette": [
        {
          "command": "muninn.toggleBold",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.toggleItalic",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.setParagraph",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.setHeading1",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.setHeading2",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.setHeading3",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.toggleBulletList",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.toggleNumberedList",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.insertLink",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.insertMermaidBlock",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.openRawMarkdown",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.inspectConfiguration"
        },
        {
          "command": "muninn.insertTable",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.insertCodeBlock",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.insertImage",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.addTableRow",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.addTableColumn",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.tableActions",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.newNote"
        },
        {
          "command": "muninn.goToHeading",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.insertFileLink",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.toggleTask",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.toggleStrike",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.undo",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        },
        {
          "command": "muninn.redo",
          "when": "activeCustomEditorId == muninn.markdownEditor"
        }
      ]
    },
    "keybindings": [
      {
        "command": "muninn.insertMermaidBlock",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "activeCustomEditorId == muninn.markdownEditor && !inputFocus"
      },
      {
        "command": "muninn.insertTable",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "activeCustomEditorId == muninn.markdownEditor && !inputFocus"
      },
      {
        "command": "muninn.tableActions",
        "key": "ctrl+alt+shift+t",
        "mac": "cmd+alt+shift+t",
        "when": "activeCustomEditorId == muninn.markdownEditor && !inputFocus"
      },
      {
        "command": "muninn.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeCustomEditorId == muninn.markdownEditor && !inputFocus"
      },
      {
        "command": "muninn.redo",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "activeCustomEditorId == muninn.markdownEditor && !inputFocus"
      },
      {
        "command": "muninn.redo",
        "key": "ctrl+y",
        "mac": "cmd+y",
        "when": "activeCustomEditorId == muninn.markdownEditor && !inputFocus"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "muninn.editorAssociations": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.editorAssociations.description%",
          "scope": "window",
          "deprecationMessage": "%configuration.editorAssociations.deprecationMessage%"
        },
        "muninn.integrations.mermaid.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.integrations.mermaid.enabled.description%",
          "scope": "resource"
        },
        "muninn.integrations.mermaid.allowInUntrustedWorkspaces": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.integrations.mermaid.allowInUntrustedWorkspaces.description%",
          "scope": "application"
        },
        "muninn.toolbar.mode": {
          "type": "string",
          "enum": [
            "basic",
            "advanced"
          ],
          "default": "basic",
          "description": "%configuration.toolbar.mode.description%",
          "scope": "window"
        },
        "muninn.appearance.contentWidth": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "comfortable",
                "full"
              ]
            },
            {
              "type": "number",
              "minimum": 40,
              "maximum": 120
            }
          ],
          "default": "comfortable",
          "description": "%configuration.appearance.contentWidth.description%",
          "scope": "window"
        },
        "muninn.images.destination": {
          "type": "string",
          "default": "images/",
          "description": "%configuration.images.destination.description%",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/integration-cli/**/*.ts\" \"tests/unit/**/*.ts\" \"package.json\" \"package-lock.json\" \"package.nls.json\" \"l10n/bundle.l10n.json\" \".vscode-test.mjs\" \"tests/electron/*.mjs\" \"scripts/*.mjs\" \"esbuild.mjs\" \"scripts/*.js\" \".github/workflows/*.yml\" \"README.md\" \"docs/ARCHITECTURE.md\" \"docs/DEVELOPMENT.md\" \"docs/GETTING_STARTED.md\" \"docs/TESTING.md\"",
    "format:check": "prettier --check --end-of-line auto \"src/**/*.ts\" \"tests/integration-cli/**/*.ts\" \"tests/unit/**/*.ts\" \"package.json\" \"package-lock.json\" \"package.nls.json\" \"l10n/bundle.l10n.json\" \".vscode-test.mjs\" \"tests/electron/*.mjs\" \"scripts/*.mjs\" \"esbuild.mjs\" \"scripts/*.js\" \".github/workflows/*.yml\" \"README.md\" \"docs/ARCHITECTURE.md\" \"docs/DEVELOPMENT.md\" \"docs/GETTING_STARTED.md\" \"docs/TESTING.md\"",
    "compile": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\" && tsc -p . && tsc -p tsconfig.tests.json && node scripts/build-test-editor.mjs",
    "bundle": "node esbuild.mjs",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "npm run test:integration",
    "test:integration": "npm run compile && npm run bundle && vscode-test",
    "test:e2e": "node --test --test-concurrency=1 tests/electron/*.test.mjs",
    "test:roundtrip": "npm run compile && node ./scripts/generate-roundtrip-report.js",
    "coverage": "npm run compile && node -r ./scripts/nyc-cpus-shim.js ./node_modules/nyc/bin/nyc.js node ./scripts/run-unit-tests.js",
    "package": "node scripts/vsce-wrapper.js package --pre-release && node scripts/check-package.mjs",
    "vscode:prepublish": "npm run compile && npm run bundle:production",
    "check:no-telemetry": "node scripts/check-no-telemetry.js",
    "bundle:production": "node esbuild.mjs --production"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "markdown-it": "^14.3.0",
    "markdown-it-front-matter": "^0.2.4",
    "mermaid": "^11.16.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.5"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.50.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "chai": "^6.2.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.2",
    "eslint-plugin-unicorn": "^62.0.0",
    "jsdom": "^27.4.0",
    "mocha": "^12.0.2",
    "nyc": "^18.0.0",
    "ovsx": "1.2.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.1",
    "sinon": "^22.0.0",
    "typescript": "^5.9.3",
    "vscode-uri": "^3.2.0",
    "yauzl": "^3.4.0"
  },
  "nyc": {
    "all": true,
    "concurrency": 1,
    "exclude-after-remap": false,
    "sourceMap": false,
    "extension": [
      ".js"
    ],
    "include": [
      "out/src/**/*.js"
    ],
    "exclude": [
      "**/*.d.ts",
      "tests/**",
      "out/src/types/config.js",
      "out/src/webview/editor/index.js",
      "out/src/webview/editor/bootstrap.js",
      "out/src/webview/editor/nodes/**",
      "out/src/webview/editor/document-navigation.js",
      "out/src/webview/editor/remote-document.js",
      "out/src/webview/editor/messages.js",
      "out/src/webview/editor/renderers/**"
    ],
    "reporter": [
      "text",
      "lcov"
    ],
    "check-coverage": true,
    "branches": 70,
    "lines": 80,
    "functions": 70,
    "statements": 80
  },
  "overrides": {
    "@vscode/test-cli": {
      "mocha": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.0.5"
      }
    }
  }
}
